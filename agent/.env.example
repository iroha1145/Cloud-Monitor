# 本地 openwebui-monitor 地址（Docker 内访问宿主机；裸跑改 http://127.0.0.1:7878）
LOCAL_MONITOR_URL=http://host.docker.internal:7878
LOCAL_API_KEY=

# 云端 Cloud-monitor hub（公网地址必须 HTTPS）
CLOUD_HUB_URL=https://your-server.example.com
CLOUD_API_KEY=

# 设备身份：建议显式固定；留空则首次生成 UUID 并持久化到状态卷
DEVICE_ID=
DEVICE_NAME=
HOST_PLATFORM=
# 数据源实例 ID（一般留空，由 /api/v1/sync/meta 自动获取）
SOURCE_INSTANCE_ID=

# 同步策略
SYNC_INTERVAL_SECONDS=60
BATCH_SIZE=200
REQUEST_TIMEOUT_SECONDS=15
HEALTH_STALE_SECONDS=3600

# 明文 HTTP 仅对 localhost/host.docker.internal/*.local 放行；公网必须 HTTPS
ALLOW_INSECURE_HTTP=false

# 逃生阀（默认关闭，仅在 agent 报错明确指示时按需打开）
# 旧版 monitor（无 /api/v1/sync/meta）回退时间窗口模式，需同时配 SOURCE_INSTANCE_ID
ALLOW_LEGACY_FALLBACK=false
# DEVICE_ID 与状态文件身份冲突时，允许以环境变量为准切换设备身份
ALLOW_STATE_CONFLICT=false
# 本地库恢复旧备份后，若游标大于当前最大记录，代理会锁存并停止。
# 设为 true 将清游标并全量重推一次；完成后必须改回 false，避免反复重推。
RESET_CURSOR=false

# 可选：token-monitor 桥接（独立设备 ID，默认 openwebui:<DEVICE_ID>）
TOKEN_MONITOR_HUB_URL=
TOKEN_MONITOR_SECRET=
TOKEN_MONITOR_DEVICE_ID=
# 官方只认 600/1200/1800；其它值会归一到最近的官方间隔
TOKEN_MONITOR_INTERVAL_SECONDS=600
# 桥接周期边界时区
TIME_ZONE=Asia/Tokyo
