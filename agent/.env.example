# 本地 openwebui-monitor 地址（agent 裸跑时填 http://127.0.0.1:7878）
LOCAL_MONITOR_URL=http://host.docker.internal:7878

# 本地 monitor 的读取密钥（ACCESS_TOKEN 或 API_KEY）
LOCAL_API_KEY=

# 云端 Cloud-monitor hub 地址与密钥（必填）
CLOUD_HUB_URL=https://your-server.example.com
CLOUD_API_KEY=与-hub-端-API_KEY-相同

# 设备标识与名称（留空则按主机名自动生成）
DEVICE_ID=
DEVICE_NAME=

# 同步间隔（秒）与单批推送上限
SYNC_INTERVAL_SECONDS=60
BATCH_SIZE=200

# 可选：token-monitor hub 多设备同步桥接（不填则停用）
TOKEN_MONITOR_HUB_URL=
TOKEN_MONITOR_SECRET=
TOKEN_MONITOR_INTERVAL_SECONDS=300
