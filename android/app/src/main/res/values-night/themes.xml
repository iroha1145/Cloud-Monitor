<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloudMonitor" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/canvas_dark</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.CloudMonitor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="postSplashScreenTheme">@style/Theme.CloudMonitor</item>
    </style>
</resources>
