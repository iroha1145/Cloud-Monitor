# ============ token-monitor 云端接入（推荐配置）============
# 本机 token-monitor widget 的多设备同步密钥（≥32 随机字符，且不得与
# API_KEY / ACCESS_TOKEN 相同）；widget 设置里 hub 填 https://<本服务器>，
# 密钥填这个值。留空则停用 token-monitor 接入。
TOKEN_MONITOR_SECRET=

# tm-core 服务地址（compose 内部固定，一般不改）
# TM_CORE_URL=http://tm-core:17321

# ============ 必填 ============
# 强随机写入密钥（openssl rand -hex 32；<32 字符/弱默认值拒绝启动）
API_KEY=
# 只读密钥（网页/API 读取用），必须与 API_KEY 不同；确需共用请设 ALLOW_SHARED_TOKEN=true
ACCESS_TOKEN=

# ============ 可选 ============
# 每设备独立写入密钥（JSON，值均需 ≥32 字符）：{"device-id-1": "key1..."}
DEVICE_KEYS_JSON=
ALLOW_SHARED_TOKEN=false
MAX_RECORDS_PER_PUSH=500
# 逗号分隔的允许跨域来源；默认不启用 CORS
CORS_ORIGINS=
# FastAPI /docs /redoc /openapi.json；默认关闭
DOCS_ENABLED=false
