# ============ 必填 ============
# 强随机写入密钥（如 openssl rand -hex 32）；changeme/please-change-me/过短值会拒绝启动
API_KEY=
# 只读密钥（网页/API 读取用），必须与 API_KEY 不同；确需共用请设 ALLOW_SHARED_TOKEN=true
ACCESS_TOKEN=

# ============ token-monitor 云端接入（推荐配置）============
# 本机 token-monitor widget 的多设备同步密钥；widget 设置里 hub 填
# https://<本服务器> 、密钥填这个值，数据即持久化到云端并在 /tm/ 面板展示
TOKEN_MONITOR_SECRET=

# ============ 可选 ============
# 每设备独立写入密钥（JSON）：{"device-id-1": "key1", "device-id-2": "key2"}
# 设备密钥只能以其绑定的 device.id 推送
DEVICE_KEYS_JSON=
ALLOW_SHARED_TOKEN=false
MAX_RECORDS_PER_PUSH=500
# 逗号分隔的允许跨域来源；默认不启用 CORS
CORS_ORIGINS=
# FastAPI /docs /redoc /openapi.json；默认关闭
DOCS_ENABLED=false
