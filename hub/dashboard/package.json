{
  "name": "cloud-monitor-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "dev:showcase": "vite --mode showcase --host 127.0.0.1 --port 5189 --strictPort",
    "build": "tsc -b && vite build",
    "build:showcase": "tsc -b && vite build --mode showcase && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5186 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "liveline": "^0.0.7",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "shadow-plugin": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
